[Unit]
Description=Standalone Map App
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/map-app
Environment=MAP_APP_DATA_DIR=%h/maps
Environment=MAP_APP_PORT=8090
ExecStart=/usr/bin/python3 %h/Projects/map-app/app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
