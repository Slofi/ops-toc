[Unit]
Description=OPS-TOC
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/ops-toc
Environment=MAP_APP_DATA_DIR=%h/maps
Environment=MAP_APP_PORT=8090
ExecStart=%h/Projects/ops-toc/venv/bin/python3 %h/Projects/ops-toc/app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
